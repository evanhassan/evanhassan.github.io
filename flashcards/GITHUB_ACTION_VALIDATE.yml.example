# Copy this file to the repository root at:
# .github/workflows/validate-study-app.yml
name: Validate Olin Huntsman Study App

on:
  pull_request:
    paths:
      - 'olin-huntsman-study/**'
  push:
    branches: [main]
    paths:
      - 'olin-huntsman-study/**'

permissions:
  contents: read

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Validate app data and embedded HTML
        run: python3 olin-huntsman-study/scripts/validate_app.py
